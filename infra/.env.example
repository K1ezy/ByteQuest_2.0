# Copy to infra/.env on the deployment host. This hostname must resolve to the
# VPS public IP, and ports 80/443 must be reachable for Caddy HTTPS.
BYTEQUEST_API_DOMAIN=api.bytequest.example
# Uvicorn uses separate SQLAlchemy pools per worker. This must be included in
# the database connection budget calculation; keep aligned with capacity.
UVICORN_WORKERS=2

# Pilot pins reviewed for Linux x86_64. Recheck release notes when replacing
# a pin. The Caddyfile requires Caddy 2.10 or newer for request-body limits.
CADDY_IMAGE=caddy:2.10-alpine@sha256:d8c17a862962def15cde69863a3a463f25a2664942eafd7bdbf050e9c3116b83
JUDGE0_IMAGE=judge0/judge0:1.13.1-extra@sha256:24865e52140d681a858696fdd90900c52640d72ad059a9a3d7ed72d4f2c60eee
JUDGE0_POSTGRES_IMAGE=postgres:16-alpine@sha256:a2f7e20374cd8fd8ed4a588b79549e10589bea7b1686e77922f5ac741b80b8a1
JUDGE0_REDIS_IMAGE=redis:7-alpine@sha256:e4ee3e03ce8f75471f40937a7c6b2b0e500390b6812fcdf5cb32c01295ded446
