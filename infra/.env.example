# Copy to infra/.env on the deployment host. This hostname must resolve to the
# VPS public IP, and ports 80/443 must be reachable for Caddy HTTPS.
BYTEQUEST_API_DOMAIN=api.bytequest.example
# Uvicorn uses separate SQLAlchemy pools per worker. This must be included in
# the database connection budget calculation; keep aligned with capacity.
UVICORN_WORKERS=2

# Select a compatible release and architecture, inspect it, then pin each image
# to its reviewed SHA-256 digest. Tags below are examples for identification only.
# The Caddyfile request-body limit requires Caddy 2.10.0 or newer.
CADDY_IMAGE=caddy:2.10-alpine
JUDGE0_IMAGE=judge0/judge0:1.13.1
JUDGE0_POSTGRES_IMAGE=postgres:16-alpine
JUDGE0_REDIS_IMAGE=redis:7-alpine
