# Copy to infra/backend.prod.env on the VPS and fill from the production
# Supabase project. Never commit the populated file.
ENVIRONMENT=production
DATABASE_URL=REPLACE_WITH_SUPABASE_POSTGRES_CONNECTION_URI_WITH_SSLMODE_REQUIRE
# Budget reserved for the backend connection ceiling of one Compose replica.
# Confirm this against the selected database plan before adding more replicas.
DB_CONNECTION_BUDGET=20
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=4
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
SUBMISSION_MAX_RETRIES=3
SUBMISSION_STALE_TIMEOUT_SECONDS=120
SUBMISSION_WORKER_CONCURRENCY=3
SUPABASE_URL=https://REPLACE_WITH_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_SIDE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

GEMINI_API_KEY=REPLACE_WITH_PRODUCTION_GEMINI_API_KEY
GEMINI_MODEL_ID=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_MODEL_ID=gemini-embedding-2
GEMINI_EMBEDDING_DIM=768

JUDGE0_API_KEY=
JUDGE0_TIMEOUT_SECONDS=15

# Keep research shadow scoring off until institution-level approval and the
# required individual consent process exist.
ML_SHADOW_ENABLED=false
ML_SHADOW_RESEARCH_APPROVED=false
RESEARCH_CONSENT_ACTIVE=false
RESEARCH_CONSENT_VERSION=
RESEARCH_CONSENT_TEXT=
EMAIL_ENABLED=false
OUTBOUND_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Future deployment: replace with exact HTTPS frontend origins. The backend
# rejects wildcard or HTTP production origins. Never copy local browser origins.
CORS_ORIGINS=["https://bytequest.example"]
