# Replace 'localhost' with 'api.<YOUR_VPS_IP>.nip.io' or your custom domain on the VPS
localhost {
    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Route all API and health traffic to the internal FastAPI container
    # Notice: Judge0 (port 2358) is NEVER exposed here (Rule 3)
    reverse_proxy fastapi:8000
}
