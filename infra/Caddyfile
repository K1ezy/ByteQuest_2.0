{$BYTEQUEST_API_DOMAIN} {
    @pdf_upload {
        method POST
        header_regexp Content-Type `(?i)^multipart/form-data\s*(;|$)`
        path_regexp `^/api/v1/(admin/materials|faculty/materials(/[^/]+/versions)?|instructor/documents/(upload|[^/]+/versions))/?$`
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000"
    }

    encode zstd gzip
    handle @pdf_upload {
        request_body {
            max_size 54525952
        }
        reverse_proxy fastapi:8000
    }

    handle {
        request_body {
            max_size 12582912
        }
        reverse_proxy fastapi:8000
    }
}
